{
  "name": "catalina-starches",
  "version": "0.0.3",
  "description": "Static Asset Viewer",
  "type": "module",
  "main": "reindex.js",
  "directories": {
    "doc": "docs"
  },
  "dependencies": {
    "@drustack/leaflet.resetview": "^1.9.2",
    "@maplibre/maplibre-gl-geocoder": "^1.8.0",
    "@maplibre/maplibre-gl-leaflet": "^0.1.0",
    "@pagefind/modular-ui": "^1.3.0",
    "@turf/helpers": "^7.2.0",
    "@turf/nearest-point": "^7.2.0",
    "@turf/points-within-polygon": "^7.2.0",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.17",
    "@types/leaflet.markercluster": "^1.5.5",
    "starches": "github:flaxandteal/starches#v0.2.1-alpha.11",
    "dompurify": "^3.2.5",
    "flatbush": "^4.4.0",
    "flatgeobuf": "^4.0.1",
    "fs": "^0.0.1-security",
    "geojson": "^0.5.0",
    "gray-matter": "^4.0.3",
    "handlebars": "^4.7.8",
    "handlebars-async-helpers-ts": "^2.0.2",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "mapbox-gl-arcgis-featureserver": "^0.0.8",
    "marked": "^15.0.7",
    "marked-plaintify": "^1.1.1",
    "toml": "^3.0.0"
  },
  "private": true,
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.14.0",
    "dotenv-cli": "^8.0.0",
    "happy-dom": "^18.0.1",
    "jsdom": "^26.1.0",
    "potree-core": "^2.0.10",
    "start-server-and-test": "^1.15.0",
    "stylelint": "^15.0.0",
    "stylelint-config-standard": "^34.0.0",
    "three": "^0.175.0",
    "ts-node": "^10.9.2",
    "tsc": "^2.0.4",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-hugo-plugin": "^5.1.0"
  },
  "scripts": {
    "test:lint:css": "stylelint \"{static,themes}/**/*.css\" --allow-empty-input",
    "start": "dotenv -e .env -- hugo server -D --bind=127.0.0.1 --port=1313",
    "dev": "dotenv vite",
    "build": "dotenv -- tsc && vite build",
    "preview": "dotenv vite preview",
    "reindex": "dotenv -- bash -c 'rm -f prebuild/preindex/* docs/definitions/business_data/* && for data in prebuild/business_data/*; do echo DATA $data; dotenv -- node --import tsx utils/preindex.ts $data; done && dotenv -- node --import tsx utils/reindex.ts'"
  }
}
